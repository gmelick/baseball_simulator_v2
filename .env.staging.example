# =============================================================================
# MLB Baseball Simulation Platform — STAGING environment template
# SIM-373 (Phase 5)
#
# Copy to .env.staging on the staging host and fill in real secrets.
# NEVER commit the filled-in file. This *.example is safe to commit.
#
# Staging mirrors production as closely as possible (auth ON, real provider,
# locked-down CORS) but points at the staging DB/Redis/frontend and runs a
# smaller worker pool. Diff this against .env.production.example to see the
# tier-specific differences.
# =============================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Non-development => API-key auth + rate limiting are ENFORCED and CORS will
# NOT fall back to "*" (see api/auth.py).
ENVIRONMENT=staging

# Real worker pool. Tune to the staging box: ~ (2 * vCPU) + 1.
WORKERS=3

# ---------------------------------------------------------------------------
# PostgreSQL — point at the managed/staging Postgres, not the compose default.
# ---------------------------------------------------------------------------
BASEBALL_DB_DSN=postgresql://baseball_user:CHANGE_ME@db-staging.internal:5432/baseball_sim_staging
# ASYNC_DB_DSN=postgresql://baseball_user:CHANGE_ME@db-staging.internal:5432/baseball_sim_staging

# ---------------------------------------------------------------------------
# DuckDB (in-process analytical layer)
# ---------------------------------------------------------------------------
BASEBALL_DUCKDB_PATH=/data/baseball_sim.duckdb
# Keep the similarity engine on in staging so it exercises the full boot path.
SIMILARITY_ENGINE_ENABLED=true

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis-staging.internal:6379/0

# ---------------------------------------------------------------------------
# MLB Stats API
# ---------------------------------------------------------------------------
MLB_API_BASE=https://statsapi.mlb.com

# ---------------------------------------------------------------------------
# Security / auth (SIM-351) — ENFORCED outside development.
# ---------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_64_char_hex_secret_for_staging

# Comma-separated API keys accepted on protected routes via X-API-Key.
# With ENVIRONMENT!=development AND keys set, missing/invalid keys => 401.
API_KEYS=CHANGE_ME_staging_key_1,CHANGE_ME_staging_key_2

# Requests/minute per API-key (or per-IP). 0 disables; set a real cap here.
RATE_LIMIT_PER_MINUTE=120

# CORS allowlist — explicit staging frontend origin(s). Never "*" in non-dev.
CORS_ORIGINS=https://staging.baseball-sim.example.com
# Single-origin shorthand (used only if CORS_ORIGINS is unset):
FRONTEND_URL=https://staging.baseball-sim.example.com

# ---------------------------------------------------------------------------
# Live pipeline / replay (Phase 5)
# ---------------------------------------------------------------------------
# Enable the live MLB ingestion pipeline + WS broadcasts in staging so the
# /ws/games/{game_pk} path is exercised end-to-end behind nginx.
LIVE_PIPELINE_ENABLED=true
# Persist replays to DuckDB for post-game inspection.
REPLAY_PERSISTENCE_ENABLED=true
# Background sim-runner worker count for the live-edge engine.
SIM_RUNNER_WORKERS=2
# Max parallel Monte-Carlo workers for batch /simulate.
SIM_MAX_WORKERS=3
# Persisted calibration report loaded at startup (optional).
CALIBRATION_REPORT_PATH=/data/calibration_report.json

# ---------------------------------------------------------------------------
# Odds provider (Phase 5/7)
# ---------------------------------------------------------------------------
# Staging can validate the real provider wiring; fall back to "mock" if you
# don't want to spend live-odds quota on staging.
ODDS_PROVIDER=mock
# ODDS_PROVIDER=theoddsapi
ODDS_PROVIDER_API_KEY=
ODDS_API_KEY=
# ODDS_API_BASE=https://api.the-odds-api.com/v4

# ---------------------------------------------------------------------------
# nginx / host port mappings (docker-compose)
# ---------------------------------------------------------------------------
# nginx fronts the stack; the app's host port need not be published in
# staging/prod (traffic enters via nginx :80/:443).
NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# DB_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# APP_HOST_PORT=8000

# ---------------------------------------------------------------------------
# Monitoring (Phase 7 — added by the metrics wave, SIM-374)
# ---------------------------------------------------------------------------
# PROMETHEUS_PUSHGATEWAY=http://pushgateway:9091
