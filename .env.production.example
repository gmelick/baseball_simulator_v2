# =============================================================================
# MLB Baseball Simulation Platform — PRODUCTION environment template
# SIM-373 (Phase 5)
#
# Copy to .env.production on the prod host and fill in real secrets from your
# secrets manager. NEVER commit the filled-in file. This *.example is safe.
#
# Production is fully locked down: API-key auth + rate limiting ENFORCED,
# CORS pinned to the real frontend origin (never "*"), a full worker pool,
# the live pipeline + replay persistence ON, and the real odds provider.
# Diff against .env.staging.example for the tier differences.
# =============================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=production

# Full worker pool. Rule of thumb: (2 * vCPU) + 1. Tune to the prod host.
WORKERS=9

# ---------------------------------------------------------------------------
# Secrets (SIM-443) — docker-compose.yml has NO default for any of these and
# fails every command, naming the variable, until each is set. Generate them
# with: python scripts/gen_secrets.py --append .env.production
# ---------------------------------------------------------------------------
# The Postgres cluster owner (the migrate service only).
POSTGRES_PASSWORD=CHANGE_ME_prod_postgres_owner_password
# baseball_app: the app, the live service and the jobs (rows in raw and sim).
BASEBALL_APP_DB_PASSWORD=CHANGE_ME_prod_app_role_password
# baseball_ro: the SQL console (reads raw only).
BASEBALL_RO_DB_PASSWORD=CHANGE_ME_prod_readonly_role_password
# Redis requirepass.
REDIS_PASSWORD=CHANGE_ME_prod_redis_password
# Grafana's admin password.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_prod_grafana_admin_password

# ---------------------------------------------------------------------------
# PostgreSQL — managed/production Postgres. Inject the real password from
# your secrets manager; do NOT inline it in a committed file. On the compose
# stack these lines are ignored: compose builds the DSNs from the passwords
# above. The app logs in as baseball_app, the console as baseball_ro.
# ---------------------------------------------------------------------------
BASEBALL_DB_DSN=postgresql://baseball_app:CHANGE_ME@db-prod.internal:5432/baseball_sim
BASEBALL_DB_RO_DSN=postgresql://baseball_ro:CHANGE_ME@db-prod.internal:5432/baseball_sim
# ASYNC_DB_DSN=postgresql://baseball_app:CHANGE_ME@db-prod.internal:5432/baseball_sim

# ---------------------------------------------------------------------------
# DuckDB (in-process analytical layer)
# ---------------------------------------------------------------------------
BASEBALL_DUCKDB_PATH=/data/baseball_sim.duckdb
SIMILARITY_ENGINE_ENABLED=true

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://:CHANGE_ME@redis-prod.internal:6379/0

# ---------------------------------------------------------------------------
# MLB Stats API
# ---------------------------------------------------------------------------
MLB_API_BASE=https://statsapi.mlb.com

# ---------------------------------------------------------------------------
# Security / auth (SIM-351, SIM-443c) — ENFORCED in every environment.
# ---------------------------------------------------------------------------
# Generate: python scripts/gen_secrets.py (prints new values to stdout).
# Source these from a secrets manager (Vault / AWS SM / GCP SM), not git.
SECRET_KEY=CHANGE_ME_inject_a_real_64_char_hex_secret_from_secrets_manager

# The browser login password. The app refuses to start without it.
AUTH_PASSWORD=

# Comma-separated production API keys (X-API-Key or Authorization: Bearer).
# A missing or invalid credential => 401. Rotate via a container restart;
# keep these out of git.
API_KEYS=CHANGE_ME_prod_key_rotate_me

# Requests/minute per API-key (or per-IP). Set a real production cap.
RATE_LIMIT_PER_MINUTE=300

# CORS allowlist — the real production frontend origin(s). MUST NOT be "*".
CORS_ORIGINS=https://baseball-sim.example.com
FRONTEND_URL=https://baseball-sim.example.com

# ---------------------------------------------------------------------------
# Live pipeline / replay (Phase 5)
# ---------------------------------------------------------------------------
LIVE_PIPELINE_ENABLED=true
REPLAY_PERSISTENCE_ENABLED=true
# SIM-561: the replay store's own file (never the analytics file above).
REPLAY_DUCKDB_PATH=/data/replay.duckdb
# Background sim-runner workers for the live-edge engine (scale to the box).
SIM_RUNNER_WORKERS=4
# Max parallel Monte-Carlo workers for batch /simulate.
SIM_MAX_WORKERS=7
CALIBRATION_REPORT_PATH=/data/calibration_report.json

# ---------------------------------------------------------------------------
# Odds provider (Phase 5/7) — REAL provider in production.
# ---------------------------------------------------------------------------
ODDS_PROVIDER=theoddsapi
ODDS_PROVIDER_API_KEY=CHANGE_ME_real_odds_provider_api_key
ODDS_API_KEY=CHANGE_ME_real_odds_provider_api_key
ODDS_API_BASE=https://api.the-odds-api.com/v4

# ---------------------------------------------------------------------------
# nginx / host port mappings (docker-compose)
# ---------------------------------------------------------------------------
# Traffic enters via nginx; publish 80 + 443 (enable the :443 server block
# in deploy/nginx/nginx.conf and mount real certs). The app's own host port
# stays internal-only behind nginx.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# DB_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# APP_HOST_PORT=8000

# ---------------------------------------------------------------------------
# Monitoring (Phase 7 — added by the metrics wave, SIM-374)
# ---------------------------------------------------------------------------
# PROMETHEUS_PUSHGATEWAY=http://pushgateway:9091
