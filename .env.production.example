# =============================================================================
# MLB Baseball Simulation Platform — PRODUCTION environment template
# SIM-373 (Phase 5)
#
# Copy to .env.production on the prod host and fill in real secrets from your
# secrets manager. NEVER commit the filled-in file. This *.example is safe.
#
# Production is fully locked down: API-key auth + rate limiting ENFORCED,
# CORS pinned to the real frontend origin (never "*"), a full worker pool,
# the live pipeline + replay persistence ON, and the real odds provider.
# Diff against .env.staging.example for the tier differences.
# =============================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=production

# Full worker pool. Rule of thumb: (2 * vCPU) + 1. Tune to the prod host.
WORKERS=9

# ---------------------------------------------------------------------------
# PostgreSQL — managed/production Postgres. Inject the real password from
# your secrets manager; do NOT inline it in a committed file.
# ---------------------------------------------------------------------------
BASEBALL_DB_DSN=postgresql://baseball_user:CHANGE_ME@db-prod.internal:5432/baseball_sim
# ASYNC_DB_DSN=postgresql://baseball_user:CHANGE_ME@db-prod.internal:5432/baseball_sim

# ---------------------------------------------------------------------------
# DuckDB (in-process analytical layer)
# ---------------------------------------------------------------------------
BASEBALL_DUCKDB_PATH=/data/baseball_sim.duckdb
SIMILARITY_ENGINE_ENABLED=true

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis-prod.internal:6379/0

# ---------------------------------------------------------------------------
# MLB Stats API
# ---------------------------------------------------------------------------
MLB_API_BASE=https://statsapi.mlb.com

# ---------------------------------------------------------------------------
# Security / auth (SIM-351) — ENFORCED.
# ---------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Source this from a secrets manager (Vault / AWS SM / GCP SM), not git.
SECRET_KEY=CHANGE_ME_inject_a_real_64_char_hex_secret_from_secrets_manager

# Comma-separated production API keys (X-API-Key). REQUIRED in prod: with
# ENVIRONMENT=production and keys set, missing/invalid keys => 401. Rotate
# via a container restart; keep these out of git.
API_KEYS=CHANGE_ME_prod_key_rotate_me

# Requests/minute per API-key (or per-IP). Set a real production cap.
RATE_LIMIT_PER_MINUTE=300

# CORS allowlist — the real production frontend origin(s). MUST NOT be "*".
CORS_ORIGINS=https://baseball-sim.example.com
FRONTEND_URL=https://baseball-sim.example.com

# ---------------------------------------------------------------------------
# Live pipeline / replay (Phase 5)
# ---------------------------------------------------------------------------
LIVE_PIPELINE_ENABLED=true
REPLAY_PERSISTENCE_ENABLED=true
# Background sim-runner workers for the live-edge engine (scale to the box).
SIM_RUNNER_WORKERS=4
# Max parallel Monte-Carlo workers for batch /simulate.
SIM_MAX_WORKERS=7
CALIBRATION_REPORT_PATH=/data/calibration_report.json

# ---------------------------------------------------------------------------
# Odds provider (Phase 5/7) — REAL provider in production.
# ---------------------------------------------------------------------------
ODDS_PROVIDER=theoddsapi
ODDS_PROVIDER_API_KEY=CHANGE_ME_real_odds_provider_api_key
ODDS_API_KEY=CHANGE_ME_real_odds_provider_api_key
ODDS_API_BASE=https://api.the-odds-api.com/v4

# ---------------------------------------------------------------------------
# nginx / host port mappings (docker-compose)
# ---------------------------------------------------------------------------
# Traffic enters via nginx; publish 80 + 443 (enable the :443 server block
# in deploy/nginx/nginx.conf and mount real certs). The app's own host port
# stays internal-only behind nginx.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# DB_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# APP_HOST_PORT=8000

# ---------------------------------------------------------------------------
# Monitoring (Phase 7 — added by the metrics wave, SIM-374)
# ---------------------------------------------------------------------------
# PROMETHEUS_PUSHGATEWAY=http://pushgateway:9091
