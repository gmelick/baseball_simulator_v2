# =============================================================================
# MLB Baseball Simulation Platform — .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# Secrets & environment — NEVER commit these
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
venv/
.venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Testing & coverage
# ---------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.benchmarks/

# ---------------------------------------------------------------------------
# Type checking
# ---------------------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json

# ---------------------------------------------------------------------------
# Linting
# ---------------------------------------------------------------------------
.ruff_cache/

# ---------------------------------------------------------------------------
# Database files
# ---------------------------------------------------------------------------
*.duckdb
*.duckdb.wal
*.db
*.sqlite

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
.dockerignore          # tracked separately — this line is just a note

# ---------------------------------------------------------------------------
# IDE & editors
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ---------------------------------------------------------------------------
# Build artifacts
# ---------------------------------------------------------------------------
*.docx
*.log
*.pid

# ---------------------------------------------------------------------------
# Scratch / temporary output (SIM-344) — never commit captured test/CLI output
#   e.g. smoke_output.txt, test_output.txt, *.clean, *.tmp
# ---------------------------------------------------------------------------
*_output.txt
*.clean
*.tmp
*.bak
*.orig
# sim_stats.py / harness measurement dumps (SIM-429) — run artifacts, not source
scripts/sim_stats*.json
# Excel lock files (the ~$ shadow file Excel opens alongside any .xlsx)
~$*
# backlog.xlsx RETIRED 2026-06-04 (comprehensive audit): hand-maintained, drifted
# badly from BACKLOG.md, no generator script — BACKLOG.md is now the single source
# of truth. Ignored so a stray local copy is never re-tracked.
backlog.xlsx
backlog_v2.xlsx
# Audit scratch dumps (xlsx/sheets extraction — not source)
sheets_dump.json
xlsx_dump.json
xlsx_fullbacklog.json

# ---------------------------------------------------------------------------
# JavaScript / Node (Phase 6 frontend — SIM-379)
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
frontend/.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Playwright E2E (SIM-400)
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/

# ---------------------------------------------------------------------------
# Data & model artifacts (large files belong in DVC / S3, not git)
# ---------------------------------------------------------------------------
# Anchored to repo root: ignore the top-level large-artifact data/ dir, but KEEP
# small committed reference fixtures under docs/data/ (e.g. foul_rate_by_count.csv).
/data/
models/
*.faiss
*.pkl
*.joblib

# ---------------------------------------------------------------------------
# Local Claude Code tool config — machine-local, not shared (permission
# allowlists, scheduled-task locks). A shared project settings.json, if the
# team ever wants one, can be re-included with a `!.claude/settings.json` line.
# ---------------------------------------------------------------------------
.claude/
