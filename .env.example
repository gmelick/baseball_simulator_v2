# =============================================================================
# MLB Baseball Simulation Platform — Environment Variables
#
# Copy this file to .env and fill in real values before running locally.
# NEVER commit .env to version control — it is in .gitignore.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   make dev
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# Full DSN used by asyncpg (live pipeline, FastAPI) and psycopg2 (ETL loader).
# Format: postgresql+psycopg2://user:password@host:port/dbname  (SQLAlchemy/Alembic)
#         postgresql://user:password@host:port/dbname           (asyncpg)
# Docker Compose default (matches docker-compose.yml service name):
BASEBALL_DB_DSN=postgresql://baseball_user:baseball_pass@db:5432/baseball_sim

# Separate asyncpg-format DSN if you need to override for the live pipeline.
# Defaults to BASEBALL_DB_DSN if not set.
# ASYNC_DB_DSN=postgresql://baseball_user:baseball_pass@db:5432/baseball_sim

# ---------------------------------------------------------------------------
# DuckDB (in-process analytical layer)
# ---------------------------------------------------------------------------

# Path to the DuckDB file that powers the similarity engines. Populated
# by pipeline/batch/player_profile_computor.py. The path below is the
# docker-compose convention; for local-host runs you'll typically use
# something like ./data/baseball_sim.duckdb.
BASEBALL_DUCKDB_PATH=/data/baseball_sim.duckdb

# Dev-onboarding escape hatch. Set to ``false`` to skip the pitcher
# similarity engine build at app startup — useful when you've stood up
# the stack but haven't yet run the historical ETL + nightly profile
# compute that populates BASEBALL_DUCKDB_PATH. When disabled, the
# similarity endpoints return 503; the rest of the API still boots.
# Default: true.
# SIMILARITY_ENGINE_ENABLED=true

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# Redis connection URL used by the live ingestion pipeline and FastAPI cache.
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# MLB Stats API
# ---------------------------------------------------------------------------

# Base URL for the MLB Stats API. Only change if using a proxy or mirror.
MLB_API_BASE=https://statsapi.mlb.com

# ---------------------------------------------------------------------------
# Odds API (Phase 7 — real provider)
# ---------------------------------------------------------------------------

# API key for your odds data provider (e.g. The Odds API, Sportradar).
# Leave blank during Phases 1–6 — mock odds are used automatically.
# NEVER commit a real key here. Set it in your .env file only.
ODDS_API_KEY=

# Odds provider base URL (used by _fetch_odds() in Phase 7).
# ODDS_API_BASE=https://api.the-odds-api.com/v4

# ---------------------------------------------------------------------------
# Data Lab — AI assistant + SQL console (SIM-439; all OPTIONAL)
# ---------------------------------------------------------------------------

# Anthropic API key. When set, the Data Lab "AI Assistant" tab is enabled: it
# writes read-only SQL, runs it through the same safe path as the SQL console,
# and explains the result. Leave blank to disable it (the SQL console + summary
# analytics still work). NEVER commit a real key — set it in your .env only.
ANTHROPIC_API_KEY=

# Assistant model. Default is cost/latency-friendly; override to claude-opus-4-8
# for maximum quality.
ASSISTANT_MODEL=claude-sonnet-5

# Bound on how many SQL steps the assistant may run per question.
MAX_ASSISTANT_STEPS=4

# SQL console / assistant guardrails (safe defaults; rarely need changing).
SQL_RUNNER_MAX_ROWS=1000
SQL_RUNNER_TIMEOUT_MS=5000
SQL_RUNNER_MAX_LEN=20000

# Optional: a dedicated GRANT-SELECT-only Postgres role DSN for the SQL runner.
# When set, the console + assistant run on this role for a hard write-guarantee;
# when unset they use the main pool inside a read-only transaction (still safe).
# BASEBALL_DB_RO_DSN=postgresql://readonly_user:pass@localhost:5432/baseball

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Secret key for signing session tokens / JWT (Phase 6+).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret-key-before-production

# Runtime environment. Controls logging verbosity and debug features.
# Valid values: development | staging | production
ENVIRONMENT=development

# Number of uvicorn worker processes. Set to 1 for development.
# Production: set to (2 * CPU_count + 1) or use gunicorn.
WORKERS=1

# ---------------------------------------------------------------------------
# Docker Compose host port mappings
# ---------------------------------------------------------------------------
# Override these if a service is already bound to the default port on your
# host (common: a locally-installed Redis on 6379, or another project's
# postgres on 5432).  The app container reaches the in-network services at
# the standard ports regardless of what host-side port you choose, so there
# is no other config to update.
#
# Example: keep your existing local Redis running and bump the compose one
# to 6380:
#   REDIS_HOST_PORT=6380
#
# DB_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# APP_HOST_PORT=8000

# ---------------------------------------------------------------------------
# Simulation
# ---------------------------------------------------------------------------

# Maximum parallel simulation workers (Phase 5).
# Defaults to os.cpu_count() - 1 if not set.
# SIM_MAX_WORKERS=3

# ---------------------------------------------------------------------------
# Monitoring (Phase 7)
# ---------------------------------------------------------------------------

# Prometheus push gateway URL (optional — metrics exported if set).
# PROMETHEUS_PUSHGATEWAY=http://pushgateway:9091
