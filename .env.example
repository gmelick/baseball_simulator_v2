# =============================================================================
# MLB Baseball Simulation Platform — Environment Variables
#
# Copy this file to .env and fill in real values before running locally.
# NEVER commit .env to version control — it is in .gitignore.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   make dev
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# Full DSN used by asyncpg (live pipeline, FastAPI) and psycopg2 (ETL loader).
# Format: postgresql+psycopg2://user:password@host:port/dbname  (SQLAlchemy/Alembic)
#         postgresql://user:password@host:port/dbname           (asyncpg)
# Docker Compose default (matches docker-compose.yml service name):
BASEBALL_DB_DSN=postgresql://baseball_user:baseball_pass@db:5432/baseball_sim

# Separate asyncpg-format DSN if you need to override for the live pipeline.
# Defaults to BASEBALL_DB_DSN if not set.
# ASYNC_DB_DSN=postgresql://baseball_user:baseball_pass@db:5432/baseball_sim

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# Redis connection URL used by the live ingestion pipeline and FastAPI cache.
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# MLB Stats API
# ---------------------------------------------------------------------------

# Base URL for the MLB Stats API. Only change if using a proxy or mirror.
MLB_API_BASE=https://statsapi.mlb.com

# ---------------------------------------------------------------------------
# Odds API (Phase 7 — real provider)
# ---------------------------------------------------------------------------

# API key for your odds data provider (e.g. The Odds API, Sportradar).
# Leave blank during Phases 1–6 — mock odds are used automatically.
# NEVER commit a real key here. Set it in your .env file only.
ODDS_API_KEY=

# Odds provider base URL (used by _fetch_odds() in Phase 7).
# ODDS_API_BASE=https://api.the-odds-api.com/v4

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Secret key for signing session tokens / JWT (Phase 6+).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret-key-before-production

# Runtime environment. Controls logging verbosity and debug features.
# Valid values: development | staging | production
ENVIRONMENT=development

# Number of uvicorn worker processes. Set to 1 for development.
# Production: set to (2 * CPU_count + 1) or use gunicorn.
WORKERS=1

# ---------------------------------------------------------------------------
# Simulation
# ---------------------------------------------------------------------------

# Maximum parallel simulation workers (Phase 5).
# Defaults to os.cpu_count() - 1 if not set.
# SIM_MAX_WORKERS=3

# ---------------------------------------------------------------------------
# Monitoring (Phase 7)
# ---------------------------------------------------------------------------

# Prometheus push gateway URL (optional — metrics exported if set).
# PROMETHEUS_PUSHGATEWAY=http://pushgateway:9091
