# =============================================================================
# MLB Baseball Simulation Platform — Environment Variables
#
# Copy this file to .env and fill in real values before running locally.
# NEVER commit .env to version control — it is in .gitignore.
#
# Usage:
#   cp .env.example .env
#   python scripts/gen_secrets.py --append .env   (or: make gen-secrets)
#   make dev
#
# SIM-443: the stack has NO default password. docker-compose.yml reads every
# secret below with ${VAR:?...}, so a missing one fails every compose command
# and names the variable. scripts/gen_secrets.py appends each missing secret
# as a random URL-safe value (no escaping needed inside a DSN); a key that is
# present, even blank, is left alone. A blank key in THIS file is a key the
# generator fills in your .env.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# SIM-443b: three login roles (db/roles/README.md). Compose builds every
# in-container DSN from these passwords, so the containers never read a DSN
# from this file.
POSTGRES_USER=baseball_user
POSTGRES_DB=baseball_sim
# The cluster owner (the superuser). Only the migrate service and the admin
# scripts log in as it. `make db-roles ROTATE_ADMIN_PASSWORD=1` applies a
# change to an existing volume.
POSTGRES_PASSWORD=
# baseball_app: the app, the live service and the jobs container. It reads and
# writes rows in raw and sim; it cannot create, alter or drop a table.
BASEBALL_APP_DB_PASSWORD=
# baseball_ro: the SQL console and the data assistant. It reads raw only, and
# every transaction it opens is read-only.
BASEBALL_RO_DB_PASSWORD=

# The HOST-side DSN, for tools you run on the host (scripts/, the ETL loader).
# Every such tool refuses to start when it is unset; none has a built-in
# default. Use the app role, with BASEBALL_APP_DB_PASSWORD in place of the
# placeholder. Formats:
#   postgresql+psycopg2://user:password@host:port/dbname  (SQLAlchemy/Alembic)
#   postgresql://user:password@host:port/dbname           (asyncpg, psycopg2)
# The containers ignore this line: compose sets their DSN.
# BASEBALL_DB_DSN=postgresql://baseball_app:CHANGE_ME@localhost:5432/baseball_sim

# Separate asyncpg-format DSN if you need to override for the live pipeline.
# Defaults to BASEBALL_DB_DSN if not set.
# ASYNC_DB_DSN=postgresql://baseball_app:CHANGE_ME@localhost:5432/baseball_sim

# ---------------------------------------------------------------------------
# DuckDB (in-process analytical layer)
# ---------------------------------------------------------------------------

# Path to the DuckDB file that powers the similarity engines. Populated
# by pipeline/batch/player_profile_computor.py. The path below is the
# docker-compose convention; for local-host runs you'll typically use
# something like ./data/baseball_sim.duckdb.
BASEBALL_DUCKDB_PATH=/data/baseball_sim.duckdb

# Dev-onboarding escape hatch. Set to ``false`` to skip the pitcher
# similarity engine build at app startup — useful when you've stood up
# the stack but haven't yet run the historical ETL + nightly profile
# compute that populates BASEBALL_DUCKDB_PATH. When disabled, the
# similarity endpoints return 503; the rest of the API still boots.
# Default: true.
# SIMILARITY_ENGINE_ENABLED=true

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# SIM-443f: Redis asks for this password (requirepass). Compose builds the
# containers' REDIS_URL from it (redis://:<password>@redis:6379/0), and the
# health check reads it as REDISCLI_AUTH.
REDIS_PASSWORD=

# The HOST-side Redis URL, for host tools. The containers ignore this line.
# REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# ---------------------------------------------------------------------------
# MLB Stats API
# ---------------------------------------------------------------------------

# Base URL for the MLB Stats API. Only change if using a proxy or mirror.
MLB_API_BASE=https://statsapi.mlb.com

# ---------------------------------------------------------------------------
# Odds API (Phase 7 — real provider)
# ---------------------------------------------------------------------------

# API key for your odds data provider (e.g. The Odds API, Sportradar).
# Leave blank during Phases 1–6 — mock odds are used automatically.
# NEVER commit a real key here. Set it in your .env file only.
ODDS_API_KEY=

# Odds provider base URL (used by _fetch_odds() in Phase 7).
# ODDS_API_BASE=https://api.the-odds-api.com/v4

# ---------------------------------------------------------------------------
# Data Lab — AI assistant + SQL console (SIM-439; all OPTIONAL)
# ---------------------------------------------------------------------------

# Anthropic API key. When set, the Data Lab "AI Assistant" tab is enabled: it
# writes read-only SQL, runs it through the same safe path as the SQL console,
# and explains the result. Leave blank to disable it (the SQL console + summary
# analytics still work). NEVER commit a real key — set it in your .env only.
ANTHROPIC_API_KEY=

# Assistant model. Default is cost/latency-friendly; override to claude-opus-4-8
# for maximum quality.
ASSISTANT_MODEL=claude-sonnet-5

# Bound on how many SQL steps the assistant may run per question.
MAX_ASSISTANT_STEPS=4

# SQL console / assistant guardrails (safe defaults; rarely need changing).
SQL_RUNNER_MAX_ROWS=1000
SQL_RUNNER_TIMEOUT_MS=5000
SQL_RUNNER_MAX_LEN=20000

# SIM-443e: the SQL console and the assistant run ONLY on the read-only
# role's pool (BASEBALL_DB_RO_DSN). Compose builds it for the app from
# BASEBALL_RO_DB_PASSWORD (baseball_ro). There is no fallback to the main
# pool: when the variable is unset, or the role is a superuser or can write,
# the console answers 503 and /health shows "sql_console": {"ro_pool": false}.
# The console reads raw.* tables only (SIM-443d). A host-side app sets it so:
# BASEBALL_DB_RO_DSN=postgresql://baseball_ro:CHANGE_ME@localhost:5432/baseball_sim

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# ---- Login (SIM-443c). Every API route and the live WebSocket require a
# credential in EVERY environment: the session cookie (POST /auth/login
# with AUTH_PASSWORD) or an API key. The app refuses to start without
# SECRET_KEY and AUTH_PASSWORD. gen_secrets.py fills all three.
# The key that signs the session cookie.
SECRET_KEY=
# The password the browser's login page asks for (one shared password).
AUTH_PASSWORD=
# Comma-separated API keys for scripts and Prometheus, sent as
# `X-API-Key: <key>` or `Authorization: Bearer <key>`. Copy one of them into
# deploy/monitoring/secrets/app_api_key so Prometheus can scrape /metrics.
API_KEYS=

# The ONE opt-out. AUTH_DISABLED=1 turns every check off: every API route and
# the live WebSocket accept requests with no credentials. The app logs a
# WARNING at boot and /health reports "auth_enforced": false. Never set it on
# a stack the LAN can reach; the test suite sets it for itself.
# AUTH_DISABLED=1

# Runtime environment. Controls logging verbosity, the CORS defaults and the
# session cookie's `secure` flag. It does NOT turn auth on or off.
# Valid values: development | staging | production
# Keep `development` while the stack serves plain HTTP: `production` marks
# the cookie secure, so the browser drops it over HTTP and the login loops.
ENVIRONMENT=development

# Number of uvicorn worker processes. Set to 1 for development.
# Production: set to (2 * CPU_count + 1) or use gunicorn.
WORKERS=1

# ---------------------------------------------------------------------------
# Docker Compose host port mappings
# ---------------------------------------------------------------------------
# SIM-443a: Postgres, Redis, the app, Prometheus and Grafana publish on the
# host's LOOPBACK address only (127.0.0.1): tools on this machine reach them,
# another machine on the LAN does not. nginx (NGINX_HTTP_PORT, default 80) is
# the one port on every interface: the LAN uses the site through it.
#
# Override these if a service is already bound to the default port on your
# host (common: a locally-installed Redis on 6379, or another project's
# postgres on 5432).  The app container reaches the in-network services at
# the standard ports regardless of what host-side port you choose, so there
# is no other config to update.
#
# Example: keep your existing local Redis running and bump the compose one
# to 6380:
#   REDIS_HOST_PORT=6380
#
# DB_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# APP_HOST_PORT=8000
# PROMETHEUS_HOST_PORT=9090
# GRAFANA_HOST_PORT=3000
# NGINX_HTTP_PORT=80

# ---------------------------------------------------------------------------
# Simulation
# ---------------------------------------------------------------------------

# Maximum parallel simulation workers (Phase 5).
# Defaults to os.cpu_count() - 1 if not set.
# SIM_MAX_WORKERS=3

# ---------------------------------------------------------------------------
# Monitoring (Phase 7)
# ---------------------------------------------------------------------------

# Prometheus push gateway URL (optional — metrics exported if set).
# PROMETHEUS_PUSHGATEWAY=http://pushgateway:9091

# SIM-443a: Grafana's admin login. The password has no default. Grafana
# reads it only when its volume is new; on an existing volume reset it with
#   docker compose exec grafana sh -c "grafana cli admin reset-admin-password \"$GF_SECURITY_ADMIN_PASSWORD\""
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# The nightly jobs container (SIM-443b)
# ---------------------------------------------------------------------------
# The scheduler runs the finals load, the Sunday sweep and the profile +
# bundle rebuild inside the `jobs` container. Its memory cap defaults to 10g,
# a ceiling, not a measurement; size it from `docker stats` during a rebuild.
# JOBS_MEM_LIMIT=10g

# ---------------------------------------------------------------------------
# SIM-519 — the live, schedule-driven slate
# ---------------------------------------------------------------------------
# The slate reads the league schedule (0 = serve the stored listing only).
SLATE_SCHEDULE_ENABLED=1
# The league read's timeout, seconds (the schedule and the per-game feed).
SLATE_FEED_TIMEOUT_S=5
# The live service writes a projected lineup (the team's last final nine)
# before the real one posts. Decision D3: built, OFF until the owner rules.
LIVE_PROJECTED_LINEUPS=0
# Never set this on the compose stack: the `live` service is the one publisher
# of live messages. It starts the pipeline inside the app (standalone use only).
LIVE_PIPELINE_ENABLED=false

# ---------------------------------------------------------------------------
# SIM-525 — the scheduled backups of the three data stores
# ---------------------------------------------------------------------------
# The nightly backups (10:00 UTC) write the Postgres dump, the DuckDB file and
# the engine-artifact bundle into this host folder. Put it outside Docker's
# disk image. Unset = ./backups inside the repo (git and docker ignore it).
# The folder sits on the same disk as Docker. The sets protect against the
# loss of Docker's disk image, `docker compose down -v`, a bad migration or
# rebuild, and accidental deletion. They do not protect against the laptop's
# disk dying: that needs an off-machine copy.
# BACKUP_DIR=C:/Users/grego/Documents/baseball_backups
# The number of complete daily sets each store keeps. The db service passes
# it (and BACKUP_MIN_FREE_GB) to the Postgres backup; the jobs service reads
# both through its env_file.
# BACKUP_KEEP=3
